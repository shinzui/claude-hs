+      oneTurn = emptyContext & #messages .~ Vector.singleton (user "Hello")
+      options = Candidate.defaultRequestOptions
+      send client request = Candidate.streamMessage client options request (\_ _ -> pure Candidate.Continue)
+      expectError fragment = \case
+        Left (Candidate.InvalidRequest detail) -> assertBool "validation detail" (Text.isInfixOf fragment detail)
+        _ -> assertFailure "Expected candidate pre-dispatch validation"
+      decodeBytes body = either fail pure (Aeson.eitherDecode body)
+      compareCall model_ ctx opts convo controls version = do
+        expected <- shapedBody model_ ctx opts
+        limit <- maybe (fail "invalid fixture limit") pure (Candidate.maxTokens 100)
+        let request = Candidate.withRequestControls controls (Candidate.MessageRequest convo limit [])
+        captures <- newIORef []
+        let app req respond = do
+              body <- Wai.strictRequestBody req >>= decodeBytes
+              modifyIORef' captures (<> [body])
+              respond (Wai.responseLBS status200 [("content-type", "text/event-stream")] "data: {\"type\":\"message_stop\"}\n\n")
+        testWithApplication (pure app) $ \port -> do
+          let config = (Candidate.defaultClientConfig "key") {Candidate.endpoint = "http://127.0.0.1:" <> show port, Candidate.apiVersion = Just version}
+          client <- Candidate.newClient config >>= either (fail . show) pure
+          _ <- send client request >>= either (fail . show) pure
+          readIORef captures >>= (@?= [expected])
+          next <- Candidate.newClient config {Candidate.apiVersion = Just "2026-10-21"} >>= either (fail . show) pure
+          case version of
+            "2023-06-01" -> do
+              send next request >>= expectError (if null (Candidate.conversationHistory convo) then "nonempty" else "sampling")
+              readIORef captures >>= (@?= [expected])
+            _ -> pure ()
+      conversation model_ features = Candidate.Conversation (model_ ^. #modelId) (Candidate.Message Candidate.User (Candidate.InputText "Hello" :| []) :| []) Nothing features
+  compareCall legacy emptyContext legacyOpts (Candidate.EmptyConversation (legacy ^. #modelId) Nothing Candidate.defaultMessageFeatures) Candidate.defaultRequestControls "2023-06-01"
