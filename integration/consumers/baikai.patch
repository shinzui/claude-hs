+        respond (Wai.responseLBS status200 [("Content-Type", "text/event-stream"), ("request-id", "req_compare")]
+          (foldMap (\frame -> "data: " <> Aeson.encode frame <> "\n\n") finalTurn))
+  testWithApplication (pure app) $ \port -> do
