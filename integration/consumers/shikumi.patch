+candidatePrediction :: TestTree
+candidatePrediction = testCase "candidate HTTP typed prediction and structured 429" $ do
+  captured <- newIORef []
+  let app req respond = do
+        Wai.pathInfo req @?= ["v1", "messages"]
+        lookup "x-api-key" (Wai.requestHeaders req) @?= Just "shikumi-trial-key"
+        body <- Wai.strictRequestBody req >>= either fail pure . eitherDecode
+        call <- atomicModifyIORef' captured (\bodies -> (bodies <> [body], length bodies))
+        if call == 0
+          then respond (Wai.responseLBS status200 [("Content-Type", "text/event-stream"), ("request-id", "req_shikumi_ok")] frames)
+          else respond (Wai.responseLBS status429 [("request-id", "req_shikumi_rate"), ("Retry-After", "7")] "{\"type\":\"error\",\"error\":{\"type\":\"rate_limit_error\",\"message\":\"slow down\"}}")
+  testWithApplication (pure app) $ \port -> do
+    registry <- newProviderRegistryFrom [claudeMessagesProvider]
+    let selected = anthropic_claude_haiku_4_5 & #baseUrl .~ ("http://127.0.0.1:" <> T.pack (show port))
+        run = runEff . runErrorNoCallStack @ShikumiError . runLLMWith registry
+          . runRouting selected . routeLLM . interpose (\_ -> \case
+            Complete model context options -> LLM.complete model context (options & #apiKey .~ Just (ApiKeyLiteral "shikumi-trial-key"))
+            Stream model context options -> LLM.stream model context (options & #apiKey .~ Just (ApiKeyLiteral "shikumi-trial-key")))
+          $ runProgram (Predict topicToOutline emptyParams) (Topic "haskell")
+    run >>= (@?= Right (Outline {points = ["intro", "body", "end"]}))
+    run >>= \case
+      Left err@(ProviderError provider) -> do
+        Baikai.category provider @?= Baikai.RateLimited
+        Baikai.httpStatus provider @?= Just 429
+        Baikai.retryAfterSeconds provider @?= Just 7
+        assertBool "retry classification left to Shikumi" (isTransient err)
+      other -> assertFailure ("expected structured provider failure, got " <> show other)
+  bodies <- readIORef captured
+  length bodies @?= 2
+  mapM_ (\case
+    Object body -> do
+      assertBool "schema supplied independently" (KM.member "output_config" body)
+      KM.lookup "tools" body @?= Nothing
+      KM.lookup "tool_choice" body @?= Nothing
+    _ -> assertFailure "expected request object") bodies
+  where
+    frame tag fields = "data: " <> encode (object (("type" .= (tag :: Text)) : fields)) <> "\n\n"
+    frames =
+      "data: {\"type\":\"message_start\",\"message\":{\"id\":\"msg_trial\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"claude-haiku-4-5\",\"content\":[],\"usage\":{\"input_tokens\":4,\"output_tokens\":0}}}\n\n"
+        <> frame "content_block_start" ["index" .= (0 :: Int), "content_block" .= object ["type" .= ("text" :: Text), "text" .= ("" :: Text)]]
+        <> frame "content_block_delta" ["index" .= (0 :: Int), "delta" .= object ["type" .= ("text_delta" :: Text), "text" .= ("{\"points\":[\"intro\",\"body\",\"end\"]}" :: Text)]]
+        <> frame "content_block_stop" ["index" .= (0 :: Int)]
+        <> frame "message_delta" ["delta" .= object ["stop_reason" .= ("end_turn" :: Text)], "usage" .= object ["output_tokens" .= (8 :: Int)]]
+        <> frame "message_stop" []
